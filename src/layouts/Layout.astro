---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="font-body bg-crema text-grafito antialiased flex flex-col min-h-screen">
    <div class="flex-1">
      <slot />
    </div>
    <footer class="py-8 text-center">
      <p class="font-mono text-[10px] sm:text-[11px] tracking-wider text-grafito/40">
        &copy; randomphenomena 2026
      </p>
    </footer>
  </body>
</html>
