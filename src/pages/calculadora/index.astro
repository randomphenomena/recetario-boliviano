---
import Layout from '../../layouts/Layout.astro';
import HeaderNav from '../../components/HeaderNav.astro';
---
<Layout title="Calculadora — Sabor de Casa">
  <HeaderNav active="calculadora" />

  <main class="max-w-3xl mx-auto px-6 sm:px-10 py-12">
    <h1 class="font-display font-extrabold text-3xl sm:text-4xl text-grafito text-center mb-4">
      Calculadora
    </h1>
    <p class="font-body text-sm text-grafito/55 text-center max-w-md mx-auto mb-10">
      Convierte porciones y ajusta cantidades de ingredientes.
    </p>
    <div class="w-full h-px bg-grafito/10"></div>
  </main>
</Layout>
